# Powers the live Student Chat demo (backend/app/services/gemini_client.py).
# Free tier -- get a key at https://aistudio.google.com/apikey (see README for steps).
GEMINI_API_KEY=

# gemini-3.5-flash-lite: Google's "fastest, most cost-effective" model --
# picked deliberately for its generous free daily quota. Newer "flagship"
# models (e.g. gemini-3.7-flash) often ship with much stingier free tiers
# (as low as 20 requests/day) that exhaust almost immediately during testing.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Only used for the on-demand "why flagged" explanation on a student's
# profile page (backend/app/services/claude_client.py). Leave unset and that
# feature falls back to a free, template-based explanation -- no cost either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Leave unset -- app/config.py already computes the correct absolute path to
# data/generated/wellbeing.db. Only set this if you deliberately want a
# different database location, and use an ABSOLUTE path if you do (a relative
# one resolves against whatever directory you happen to run commands from,
# not the project root, and will break scripts run from backend/ or scripts/).
DATABASE_URL=
